{
  "name": "codrix-server",
  "version": "1.0.0",
  "description": "Codrix Modular Monolith Multi-Tenant API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/core/migrations/cli.ts up",
    "migrate:status": "tsx src/core/migrations/cli.ts status",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx src/prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^2.12.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.14.5",
    "mongodb": "^7.9.0",
    "nodemailer": "^10.6.0",
    "socket.io": "^4.8.4",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
